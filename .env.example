# ==========================================
# Application
# ==========================================
APP_ENV=development
APP_PORT=8080

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=10042003
DB_NAME=bus_booking
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=15m

# Goose migration connection string (used by Makefile migrate-* targets).
# Must be a valid lib/pq URL: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://postgres:10042003@localhost:5432/bus_booking?sslmode=disable

# ==========================================
# JWT
# ==========================================
# Required when APP_ENV=production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h
